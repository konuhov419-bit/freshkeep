# Скопируйте в .env. При первом запуске сервер создаёт .env сам со случайным JWT_SECRET.
PORT=5173
# Секрет подписи токенов, минимум 32 символа. Генерация: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Внешний адрес приложения (без / на конце). Нужен для OAuth redirect_uri, Secure-cookie и HSTS. Пример: https://freshkeep.up.railway.app
PUBLIC_URL=
# Дополнительные источники для CORS/CSRF через запятую, если фронтенд на другом домене. Пусто = только свой адрес
ALLOWED_ORIGIN=
# 1 = доверять X-Forwarded-For (только если приложение стоит за прокси хостинга: Railway, Render, nginx)
TRUST_PROXY=0
DB_PATH=data/freshkeep.db
# Файл логов; "-" = писать только в stdout (для хостингов с централизованным сбором логов)
LOG_FILE=logs/api.log
# debug | info | warn | error
LOG_LEVEL=info

# OAuth2: провайдер включается, когда заданы обе переменные (redirect URI: PUBLIC_URL + /api/auth/oauth/<google|yandex>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Яндекс.Метрика: номер счётчика (только цифры). Пусто = аналитика выключена
METRIKA_ID=

# Токен для GET /api/metrics (Prometheus). Пусто = метрики выключены. Генерация как у JWT_SECRET
METRICS_TOKEN=
